   "source": [
    "# Read raw transactions data for Hospital B from Bronze layer (ADLS)\n",
    "hosb_txn_df = spark.read.format(\"parquet\").load(\n",
    "    \"abfss://bronze@hrcmstorage.dfs.core.windows.net/hosb/transactions\"\n",
    ")\n",
    "\n",
    "# Preview the raw Bronze data\n",
    "display(hosb_txn_df.limit(5))"
   ]
  },
