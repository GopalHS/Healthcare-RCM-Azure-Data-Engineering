   "source": [
    "# Read back the Silver data to verify successful write operation\n",
    "check_df = spark.read.format(\"delta\").load(\n",
    "    \"abfss://silver@hrcmstorage.dfs.core.windows.net/hosb/transactions\"\n",
    ")\n",
    "\n",
    "# Display sample records from Silver layer\n",
    "display(check_df.limit(10))"
   ]
  },
