   "source": [
    "# Write cleaned transactions data to Silver layer in Delta format\n",
    "silver_hosb_txn_df.write.format(\"delta\").mode(\"overwrite\").save(\n",
    "    \"abfss://silver@hrcmstorage.dfs.core.windows.net/hosb/transactions\"\n",
    ")"
   ]
  },
