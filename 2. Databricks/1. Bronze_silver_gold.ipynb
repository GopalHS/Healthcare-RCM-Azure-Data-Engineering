    }
   },
   "outputs": [],
   "source": [
    "# Select required columns and apply basic data quality checks to create Silver dataset\n",
    "from pyspark.sql.functions import col, when, current_timestamp\n",
    "\n",
    "silver_hosb_txn_df = hosb_txn_df.select(\n",
    "    col(\"TransactionID\"),\n",
    "    col(\"EncounterID\"),\n",
    "    col(\"PatientID\"),\n",
    "    col(\"ProviderID\"),\n",
    "    col(\"DeptID\"),\n",
    "    col(\"VisitDate\"),\n",
    "    col(\"ServiceDate\"),\n",
    "    col(\"PaidDate\"),\n",
    "    col(\"VisitType\"),\n",
    "    col(\"Amount\"),\n",
    "    col(\"AmountType\"),\n",
    "    col(\"PaidAmount\"),\n",
    "    col(\"ClaimID\"),\n",
    "    col(\"PayorID\"),\n",
    "    col(\"ProcedureCode\"),\n",
    "    col(\"ICDCode\"),\n",
    "    col(\"LineOfBusiness\"),\n",
    "    col(\"MedicaidID\"),\n",
    "    col(\"MedicareID\"),\n",
    "    col(\"InsertDate\"),\n",
    "    col(\"ModifiedDate\"),\n",
    "    col(\"datasource\")\n",
    ").withColumn(\n",
    "    # Flag records with missing critical fields for data quality tracking\n",
    "    \"is_quarantined\",\n",
    "    when(\n",
    "        col(\"TransactionID\").isNull() |\n",
    "        col(\"EncounterID\").isNull() |\n",
    "        col(\"PatientID\").isNull() |\n",
    "        col(\"ServiceDate\").isNull(),\n",
    "        True\n",
    "    ).otherwise(False)\n",
    ").withColumn(\n",
    "    # Add audit timestamp to track when record is inserted into Silver layer\n",
    "    \"audit_insert_date\",\n",
    "    current_timestamp()\n",
    ")"
   ]
  },
