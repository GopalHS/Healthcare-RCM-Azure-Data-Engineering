   "source": [
    "Advanced Gold\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 0,
   "metadata": {
    "application/vnd.databricks.v1+cell": {
     "cellMetadata": {
      "byteLimit": 2048000,
      "rowLimit": 10000
     },
     "finishTime": 1776788890231,
     "inputWidgets": {},
     "nuid": "2d229781-1741-4feb-ba1d-9d0aff217acd",
     "showTitle": false,
     "startTime": 1776788889768,
     "submitTime": 1776788889705,
     "tableResultSettingsMap": {},
     "title": ""
    }
   },
   "outputs": [],
   "source": [
    "# Read Silver data\n",
    "hosa_silver_df = spark.read.format(\"delta\").load(\n",
    "    \"abfss://silver@hrcmstorage.dfs.core.windows.net/hosa/transactions\"\n",
    ")\n",
    "\n",
    "hosb_silver_df = spark.read.format(\"delta\").load(\n",
    "    \"abfss://silver@hrcmstorage.dfs.core.windows.net/hosb/transactions\"\n",
    ")\n",
    "\n",
    "# Combine both\n",
    "combined_df = hosa_silver_df.unionByName(hosb_silver_df)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 0,
   "metadata": {
    "application/vnd.databricks.v1+cell": {
     "cellMetadata": {
      "byteLimit": 2048000,
      "rowLimit": 10000
     },
     "finishTime": 1776788893631,
     "inputWidgets": {},
     "nuid": "78e7dfc3-6703-43a3-b0e7-ab778878b05c",
     "showTitle": false,
     "startTime": 1776788893469,
     "submitTime": 1776788893422,
     "tableResultSettingsMap": {},
     "title": ""
    }
   },
   "outputs": [],
   "source": [
    "from pyspark.sql.functions import col\n",
    "\n",
    "# Add business metrics\n",
    "enhanced_df = combined_df.withColumn(\n",
    "    \"payment_ratio\",\n",
    "    col(\"PaidAmount\") / col(\"Amount\")\n",
    ").withColumn(\n",
    "    \"outstanding_amount\",\n",
    "    col(\"Amount\") - col(\"PaidAmount\")\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 0,
   "metadata": {
    "application/vnd.databricks.v1+cell": {
     "cellMetadata": {
      "byteLimit": 2048000,
      "rowLimit": 10000
     },
     "finishTime": 1776788897338,
     "inputWidgets": {},
     "nuid": "44732590-d5ae-4a32-b2b8-63160274e910",
     "showTitle": false,
     "startTime": 1776788897068,
     "submitTime": 1776788897024,
     "tableResultSettingsMap": {},
     "title": ""
    }
   },
   "outputs": [],
   "source": [
    "# AGGREGATE\n",
    "from pyspark.sql.functions import sum, avg, count\n",
    "\n",
    "gold_advanced_df = enhanced_df.groupBy(\"VisitType\").agg(\n",
    "    count(\"TransactionID\").alias(\"total_transactions\"),\n",
    "    sum(\"Amount\").alias(\"total_billed\"),\n",
    "    sum(\"PaidAmount\").alias(\"total_paid\"),\n",
    "    sum(\"outstanding_amount\").alias(\"total_outstanding\"),\n",
    "    avg(\"payment_ratio\").alias(\"avg_payment_ratio\")\n",
    ")"
   ]
  },
