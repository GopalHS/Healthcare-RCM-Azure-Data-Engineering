    }
   },
   "source": [
    "Now start we the Gold layer"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 0,
   "metadata": {
    "application/vnd.databricks.v1+cell": {
     "cellMetadata": {
      "byteLimit": 2048000,
      "rowLimit": 10000
     },
     "finishTime": 1776788806539,
     "inputWidgets": {},
     "nuid": "8a490bd9-01fd-4591-af97-224a84470ead",
     "showTitle": false,
     "startTime": 1776788805719,
     "submitTime": 1776788805642,
     "tableResultSettingsMap": {},
     "title": ""
    }
   },
   "outputs": [],
   "source": [
    "# Read Silver data\n",
    "hosa_silver_df = spark.read.format(\"delta\").load(\n",
    "    \"abfss://silver@hrcmstorage.dfs.core.windows.net/hosa/transactions\"\n",
    ")\n",
    "\n",
    "hosb_silver_df = spark.read.format(\"delta\").load(\n",
    "    \"abfss://silver@hrcmstorage.dfs.core.windows.net/hosb/transactions\"\n",
    ")\n",
    "\n",
    "# Combine both\n",
    "combined_df = hosa_silver_df.unionByName(hosb_silver_df)\n",
    "\n",
    "from pyspark.sql.functions import sum, count\n",
    "\n",
    "# Create gold_df again\n",
    "gold_df = combined_df.groupBy(\"datasource\").agg(\n",
    "    count(\"TransactionID\").alias(\"total_transactions\"),\n",
    "    sum(\"Amount\").alias(\"total_billed_amount\"),\n",
    "    sum(\"PaidAmount\").alias(\"total_paid_amount\")\n",
    ")"
   ]
  },
