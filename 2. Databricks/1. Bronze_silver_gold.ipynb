   "source": [
    "\n",
    "gold_check_df = spark.read.format(\"delta\").load(\n",
    "    \"abfss://gold@hrcmstorage.dfs.core.windows.net/transactions_summary\"\n",
    ")\n",
    "\n",
    "display(gold_check_df)"
   ]
  },
